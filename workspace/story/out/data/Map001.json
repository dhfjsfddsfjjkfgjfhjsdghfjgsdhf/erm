{"id":1,"name":"Opening (Hanma)","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Cast","direction":4,"pattern":1,"characterIndex":1},"list":[{"code":121,"indent":0,"parameters":[1,1,0]},{"code":216,"indent":0,"parameters":[1]},{"code":221,"indent":0,"parameters":[]},{"code":236,"indent":0,"parameters":["none",0,0,false]},{"code":281,"indent":0,"parameters":[1]},{"code":357,"indent":0,"parameters":["Story_Core","ChapterCard","ChapterCard",{"title":"Prolog · Erwachen","subtitle":"01. Blütenmond 1047","duration":"220"}]},{"code":657,"indent":0,"parameters":["title = Prolog · Erwachen"]},{"code":657,"indent":0,"parameters":["subtitle = 01. Blütenmond 1047"]},{"code":657,"indent":0,"parameters":["duration = 220"]},{"code":101,"indent":0,"parameters":["",0,1,1,""]},{"code":401,"indent":0,"parameters":["…"]},{"code":101,"indent":0,"parameters":["",0,1,1,""]},{"code":401,"indent":0,"parameters":["Cold. Stone under your back."]},{"code":401,"indent":0,"parameters":["The smell of wet rock."]},{"code":101,"indent":0,"parameters":["",0,1,1,""]},{"code":401,"indent":0,"parameters":["Somewhere, water drips: slow and patient, as if it had"]},{"code":401,"indent":0,"parameters":["been counting for a very long time."]},{"code":222,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[30]},{"code":213,"indent":0,"parameters":[-1,8,true]},{"code":101,"indent":0,"parameters":["Kanta",0,0,2,"Kanta"]},{"code":401,"indent":0,"parameters":["…Where…"]},{"code":101,"indent":0,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":0,"parameters":["You're awake, my Lord. Good. I was beginning to think"]},{"code":401,"indent":0,"parameters":["this body wouldn't take you at all."]},{"code":205,"indent":0,"parameters":[-1,{"list":[{"code":18,"parameters":[]},{"code":0,"parameters":[]}],"repeat":false,"skippable":false,"wait":true}]},{"code":505,"indent":0,"parameters":[{"code":18,"parameters":[]}]},{"code":101,"indent":0,"parameters":["Kanta",0,0,2,"Kanta"]},{"code":401,"indent":0,"parameters":["Who are you?"]},{"code":101,"indent":0,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":0,"parameters":["Hanma. Once a general. Of what hardly matters; it's"]},{"code":401,"indent":0,"parameters":["all dust now. What I am now is yours: bound to your"]},{"code":401,"indent":0,"parameters":["soul, it seems, whether either of us likes it."]},{"code":101,"indent":0,"parameters":["Kanta",0,0,2,"Kanta"]},{"code":401,"indent":0,"parameters":["…My soul."]},{"code":101,"indent":0,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":0,"parameters":["You woke in an empty body. No name on it, no purse,"]},{"code":401,"indent":0,"parameters":["no blade. Only that silver armor and the red cape."]},{"code":401,"indent":0,"parameters":["I was already here when you opened your eyes."]},{"code":205,"indent":0,"parameters":[-1,{"list":[{"code":16,"parameters":[]},{"code":0,"parameters":[]}],"repeat":false,"skippable":false,"wait":true}]},{"code":505,"indent":0,"parameters":[{"code":16,"parameters":[]}]},{"code":250,"indent":0,"parameters":[{"name":"Starlight","volume":80,"pitch":110,"pan":0}]},{"code":224,"indent":0,"parameters":[[170,210,255,170],40,true]},{"code":101,"indent":0,"parameters":["",0,1,1,""]},{"code":401,"indent":0,"parameters":["Light spills from her open hand: a thin blade of pale"]},{"code":401,"indent":0,"parameters":["blue, no longer than a finger. It hums, faintly, and"]},{"code":401,"indent":0,"parameters":["throws the cave into sharp blue shadow."]},{"code":101,"indent":0,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":0,"parameters":["That's yours too. A weapon of pure mana. Small now."]},{"code":401,"indent":0,"parameters":["It'll grow as you do."]},{"code":101,"indent":0,"parameters":["Kanta",0,0,2,"Kanta"]},{"code":401,"indent":0,"parameters":["Where are we?"]},{"code":101,"indent":0,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":0,"parameters":["North, going by the cold. Past that, I can't say."]},{"code":401,"indent":0,"parameters":["My last good map is older than anyone alive."]},{"code":101,"indent":0,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":0,"parameters":["There's daylight up the passage. Look around first if"]},{"code":401,"indent":0,"parameters":["you like, but carefully. I heard something breathing"]},{"code":401,"indent":0,"parameters":["down by the water."]},{"code":101,"indent":0,"parameters":["",0,1,1,""]},{"code":401,"indent":0,"parameters":["\\C[6]Stat points\\C[0]: open the menu and choose \\C[6]Stat Points\\C[0]."]},{"code":401,"indent":0,"parameters":["Kanta and Hanma each have 20 to spend. Kanta's light"]},{"code":401,"indent":0,"parameters":["runs on DEX; Hanma heals with WIS and rots with MAG."]},{"code":101,"indent":0,"parameters":["",0,1,1,""]},{"code":401,"indent":0,"parameters":["Your three best stats set your \\C[6]rank\\C[0] (F to V). A rank"]},{"code":401,"indent":0,"parameters":["above you hits half again as hard; two above,"]},{"code":401,"indent":0,"parameters":["twice as hard. Don't pick fights with those."]},{"code":121,"indent":0,"parameters":[67,67,0]},{"code":123,"indent":0,"parameters":["A",0]},{"code":216,"indent":0,"parameters":[0]},{"code":217,"indent":0,"parameters":[]},{"code":281,"indent":0,"parameters":[0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Vali
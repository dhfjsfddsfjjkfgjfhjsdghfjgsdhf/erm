{"id":27,"name":"Night","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"","direction":2,"pattern":0,"characterIndex":0},"list":[{"code":357,"indent":0,"parameters":["McKathlin_DayNight","setTime","setTime",{"time_of_day":"{\"hour\": \"9\", \"minutes\": \"0\", \"ampm\": \"PM\"}"}]},{"code":657,"indent":0,"parameters":["time_of_day = {\"hour\": \"9\", \"minutes\": \"0\", \"ampm\": \"PM\"}"]},{"code":230,"indent":0,"parameters":[20]},{"code":101,"indent":0,"parameters":["",0,1,1,""]},{"code":401,"indent":0,"parameters":["Night at the wayside shrine. The statue's face has been"]},{"code":401,"indent":0,"parameters":["worn smooth by a thousand years of rain and hands."]},{"code":101,"indent":0,"parameters":["People2",4,0,2,"Sagara Takumi"]},{"code":401,"indent":0,"parameters":["So. Eisfurt. The river there, the Eis, froze at the new"]},{"code":401,"indent":0,"parameters":["moon. In Blütenmond! Ice thick enough to walk on, and"]},{"code":401,"indent":0,"parameters":["nobody dares."]},{"code":101,"indent":0,"parameters":["People2",4,0,2,"Sagara Takumi"]},{"code":401,"indent":0,"parameters":["No ferry, no trade. My salt's worth nothing if it sits"]},{"code":401,"indent":0,"parameters":["on the wrong bank."]},{"code":101,"indent":0,"parameters":["Kanta",0,0,2,"Kanta"]},{"code":401,"indent":0,"parameters":["A late winter."]},{"code":101,"indent":0,"parameters":["People2",4,0,2,"Sagara Takumi"]},{"code":401,"indent":0,"parameters":["Winter doesn't come back after it's left. Folk in Eisfurt"]},{"code":401,"indent":0,"parameters":["say Fubuki is angry: the snow-woman of the Eisfall."]},{"code":101,"indent":0,"parameters":["People2",4,0,2,"Sagara Takumi"]},{"code":401,"indent":0,"parameters":["Every year they put the first silver in a bowl at her"]},{"code":401,"indent":0,"parameters":["shrine, and every spring she lets the river go."]},{"code":401,"indent":0,"parameters":["…A bowl. Like the one the deserters had."]},{"code":101,"indent":0,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":0,"parameters":["So someone robbed a spirit, and a town is paying for it."]},{"code":401,"indent":0,"parameters":["That's how it usually goes."]},{"code":101,"indent":0,"parameters":["People2",4,0,2,"Sagara Takumi"]},{"code":401,"indent":0,"parameters":["I'll sleep on that. Night."]},{"code":221,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[30]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,1,1,""]},{"code":401,"indent":0,"parameters":["Later. Sagara snores. The fire is low."]},{"code":101,"indent":0,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":0,"parameters":["You haven't asked me much, my Lord."]},{"code":101,"indent":0,"parameters":["Kanta",0,0,2,"Kanta"]},{"code":401,"indent":0,"parameters":["Would you answer?"]},{"code":101,"indent":0,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":0,"parameters":["Some of it."]},{"code":101,"indent":0,"parameters":["Kanta",0,0,2,"Kanta"]},{"code":401,"indent":0,"parameters":["What were you a general of?"]},{"code":101,"indent":0,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":0,"parameters":["An army that marched north to end every demon in the"]},{"code":401,"indent":0,"parameters":["world. We burned a great deal of the north doing it."]},{"code":401,"indent":0,"parameters":["We didn't finish."]},{"code":101,"indent":0,"parameters":["Kanta",0,0,2,"Kanta"]},{"code":401,"indent":0,"parameters":["And now?"]},{"code":101,"indent":0,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":0,"parameters":["Now I mend strangers and watch you sleep in cold"]},{"code":401,"indent":0,"parameters":["places. A promotion, of sorts."]},{"code":101,"indent":0,"parameters":["Kanta",0,0,2,"Kanta"]},{"code":401,"indent":0,"parameters":["…Why me?"]},{"code":101,"indent":0,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":0,"parameters":["I don't know. I woke beside you; the thread chose, not I."]},{"code":401,"indent":0,"parameters":["But I've watched you three days. You help people who"]},{"code":401,"indent":0,"parameters":["can't pay you, and you know when to walk away."]},{"code":101,"indent":0,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":0,"parameters":["That's rarer than courage."]},{"code":101,"indent":0,"parameters":["Kanta",0,0,2,"Kanta"]},{"code":401,"indent":0,"parameters":["I don't feel brave."]},{"code":101,"indent":0,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":0,"parameters":["Good. The brave ones died first, in my war."]},{"code":117,"indent":0,"parameters":[2]},{"code":357,"indent":0,"parameters":["Story_Core","SetRestPoint","SetRestPoint",{"mapId":"21","x":"10","y":"13","direction":"8"}]},{"code":657,"indent":0,"parameters":["mapId = 21"]},{"code":657,"indent":0,"parameters":["x = 10"]},{"code":657,"indent":0,"parameters":["y = 13"]},{"code":657,"indent":0,"parameters":["direction = 8"]},{"code":121,"indent":0,"parameters":[19,19,0]},{"code":123,"indent":0,"parameters":["A",0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"","direction":2,"pattern":0,"characterIndex":0},"list":[{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"par
{"id":3,"name":"Amane Kiyoko","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"People2","direction":2,"pattern":1,"characterIndex":5},"list":[{"code":111,"indent":0,"parameters":[0,110,0]},{"code":101,"indent":1,"parameters":["People2",5,0,2,"Amane Kiyoko"]},{"code":401,"indent":1,"parameters":["The bells are ringing again. That's you. Go with the"]},{"code":401,"indent":1,"parameters":["Dawn, child. The Guild's archivist has something for you."]},{"code":0,"indent":1,"parameters":[]},{"code":411,"indent":0,"parameters":[]},{"code":111,"indent":1,"parameters":[0,101,0]},{"code":101,"indent":2,"parameters":["People2",5,0,2,"Amane Kiyoko"]},{"code":401,"indent":2,"parameters":["The guild takes the names. The arena takes the rest."]},{"code":0,"indent":2,"parameters":[]},{"code":411,"indent":1,"parameters":[]},{"code":101,"indent":2,"parameters":["People2",5,0,2,"Amane Kiyoko"]},{"code":401,"indent":2,"parameters":["Amane Kiyoko, high priestess of the Morgendom. You have"]},{"code":401,"indent":2,"parameters":["a dead general standing behind you, child, and she's"]},{"code":401,"indent":2,"parameters":["staring at my ceiling."]},{"code":101,"indent":2,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":2,"parameters":["I've seen it before. When it was new."]},{"code":101,"indent":2,"parameters":["Kanta",0,0,2,"Kanta"]},{"code":401,"indent":2,"parameters":["We're looking for the Morgenklinge."]},{"code":101,"indent":2,"parameters":["People2",5,0,2,"Amane Kiyoko"]},{"code":401,"indent":2,"parameters":["Of course you are. Everyone is, all of a sudden."]},{"code":101,"indent":2,"parameters":["People2",5,0,2,"Amane Kiyoko"]},{"code":401,"indent":2,"parameters":["…The Morgenklinge is this year's tournament prize. The"]},{"code":401,"indent":2,"parameters":["Empress thinks it is a pretty old sword. It sat in her"]},{"code":401,"indent":2,"parameters":["vault for three hundred years and nobody remembered."]},{"code":101,"indent":2,"parameters":["People2",5,0,2,"Amane Kiyoko"]},{"code":401,"indent":2,"parameters":["Win it. Bring it to me before you do anything clever"]},{"code":401,"indent":2,"parameters":["with it. Guild teams may enter the Sonnwende: the guild"]},{"code":401,"indent":2,"parameters":["on the cross street takes the names."]},{"code":101,"indent":2,"parameters":["Actor3",2,0,2,"Tsukishiro Yukino"]},{"code":401,"indent":2,"parameters":["…"]},{"code":101,"indent":2,"parameters":["People2",5,0,2,"Amane Kiyoko"]},{"code":401,"indent":2,"parameters":["And Tsukishiro. You came back after all. I prayed for"]},{"code":401,"indent":2,"parameters":["the Morgenwacht every morning for twelve years."]},{"code":101,"indent":2,"parameters":["Actor3",2,0,2,"Tsukishiro Yukino"]},{"code":401,"indent":2,"parameters":["…Thank you."]},{"code":357,"indent":2,"parameters":["WD_Quest","newCreateQuest","Create Quest",{"id":"27","icon":"87","cat":"0","short":"Das Sonnwende-Turnier","long":"Das Sonnwende-Turnier","index":"27","giver":"Amane Kiyoko","area":"Lichtenhall, Kaiserarena","desc":"The Morgenklinge is the prize of this year's Sonnwende tournament: the Empress thinks it is a pretty old sword. Guild teams may enter. Register at the Lichtenhall guild, then fight four rounds in the Kaiserarena.","questTrans":"[]","status":"ongoing","logs":"[]","track":"{\"isTrackable\": \"true\", \"text\": \"Register at the guild; the arena is in the east of the city.\", \"textTrans\": \"[]\"}"}]},{"code":657,"indent":2,"parameters":["id = 27"]},{"code":657,"indent":2,"parameters":["icon = 87"]},{"code":657,"indent":2,"parameters":["cat = 0"]},{"code":657,"indent":2,"parameters":["short = Das Sonnwende-Turnier"]},{"code":657,"indent":2,"parameters":["long = Das Sonnwende-Turnier"]},{"code
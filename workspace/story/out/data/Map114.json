401,"indent":0,"parameters":["Tōma. He sends his regards to his saint."]},{"code":301,"indent":0,"parameters":[0,121,false,false]},{"code":121,"indent":0,"parameters":[147,147,0]},{"code":250,"indent":0,"parameters":[{"name":"Book2","volume":90,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Mukuro comes apart like a book in the rain: pages, grey"]},{"code":401,"indent":0,"parameters":["dust, a smell of old libraries. The hollow men stop"]},{"code":401,"indent":0,"parameters":["digging and lie down, and are only dead."]},{"code":355,"indent":0,"parameters":["$gameMap.event(6).setImage('', 0);"]},{"code":101,"indent":0,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":0,"parameters":["Two of the Four. Tsumugi, Mukuro. That leaves Shigure,"]},{"code":401,"indent":0,"parameters":["and Gōen. And then him."]},{"code":221,"indent":0,"parameters":[]},{"code":201,"indent":0,"parameters":[0,111,21,36,8,0]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["Nature",6,0,2,"Gräfin Kagura Yui"]},{"code":401,"indent":0,"parameters":["The forest is quiet. It hasn't been quiet in a year."]},{"code":101,"indent":0,"parameters":["Nature",6,0,2,"Gräfin Kagura Yui"]},{"code":401,"indent":0,"parameters":["Hohenwacht remembers us when it needs something."]},{"code":401,"indent":0,"parameters":["Hirschheim remembers its friends. Take this: the Waldkrone"]},{"code":401,"indent":0,"parameters":["my grandmother wore at the last war."]},{"code":128,"indent":0,"parameters":[89,0,0,1,false]},{"code":357,"indent":0,"parameters":["WD_Quest","SetCompletion","Set Quest Completion Parameter",{"questID":"32","questName":"","status":"completed"}]},{"code":657,"indent":0,"parameters":["questID = 32"]},{"code":657,"indent":0,"parameters":["questName = "]},{"code":657,"indent":0,"parameters":["status = completed"]},{"code":111,"indent":0,"parameters":[0,140,1]},{"code":101,"indent":1,"parameters":["",0,1,1,""]},{"code":401,"indent":1,"parameters":["That night Hanma doesn't stand behind the fire. She sits"]},{"code":401,"indent":1,"parameters":["down at it, which she never does, and looks at the"]},{"code":401,"indent":1,"parameters":["lantern for a long time."]},{"code":101,"indent":1,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":1,"parameters":["I promised. When we had the second one."]},{"code":101,"indent":1,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":1,"parameters":["Seven hundred and thirty-five years ago I was a general"]},{"code":401,"indent":1,"parameters":["of the Dawn Host. Sōryū Akira's general. One of five."]},{"code":401,"indent":1,"parameters":["The youngest, and the angriest."]},{"code":101,"indent":1,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":1,"parameters":["The Demon Lord had burned my city when I was nine. I"]},{"code":401,"indent":1,"parameters":["wanted every demon in the world dead, and everything that"]},{"code":401,"indent":1,"parameters":["had touched one, and everything that might, later."]},{"code":101,"indent":1,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":1,"parameters":["So I purged. Villages the miasma had brushed. Wells. Once"]},{"code":401,"indent":1,"parameters":["a whole valley, because two of the dead there had been"]},{"code":401,"indent":1,"parameters":["seen to twitch. The Death arts, you've seen them. I was"]},{"code":101,"indent":1,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":1,"parameters":["very good at them."]},{"code":101,"indent":1,"parameters":["Falin",0,0,2,"Falin"]},{"code":401,"indent":1,"parameters":["…And Akira?"]},{"code":101,"indent":1,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":1,"parameters":["Akira took my command away at Frostheim, the last winter"]},{"code":401,"indent":1,"parameters":["of the war. In front of the Host. I was dying by then,"]},{"code":401,"indent":1,"parameters":["a spear through me, and I was so angry I couldn't see."]},{"code":101,"indent":1,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":1,"parameters":["Something came to me, lying there in the snow. A merchant"]},{"code":401,"indent":1,"parameters":["in brass, with a contract for anger. Keep fighting, he"]},{"code":401,"indent":1,"parameters":["said. Forever. Purge everything. Only sign."]},{"code":101,"indent":1,"parameters":["Kanta",0,0,2,"Kanta"]},{"code":401,"indent":1,"parameters":["Gōen."]},{"code":101,"indent":1,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":1,"parameters":["Akira tore the contract out of my hands. She refused it"]},{"code":401,"indent":1,"parameters":["for me. So I died, angry, unbought, and I stayed angry"]},{"code":401,"indent":1,"parameters":["for seven hundred years, in the dark, until a thread"]},{"code":101,"indent":1,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":1,"parameters":["pulled tight and there was a girl with a light in her"]},{"code":401,"indent":1,"parameters":["hand, waking up in a cave."]},{"code":101,"indent":1,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":1,"parameters":["\"The General who was refused.\" That's what he calls me."]},{"code":401,"indent":1,"parameters":["He's right. It's the best thing anyone ever did for me."]},{"code":101,"indent":1,"parameters":["Actor3",2,0,2,"Tsukishiro Yukino"]},{"code":401,"indent":1,"parameters":["…"]},{"code":101,"indent":1,"parameters":["Kanta",0,0,2,"Kanta"]},{"code":401,"indent":1,"parameters":["Are you still angry?"]},{"code":101,"indent":1,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":1,"parameters":["…Less, my Lord. Less every day. Don't tell anyone."]},{"code":121,"indent":1,"parameters":[140,140,0]},{"code":0,"indent":1,"parameters":[]},{"code":412,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[20]},{"code":250,"indent":0,"parameters":[{"name":"Horse","volume":90,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["People3",7,0,2,"Bote"]},{"code":401,"indent":0,"parameters":["For the Guild vessel! From Salzhafen, the League of the"]},{"code":401,"indent":0,"parameters":["coast: Shigure is drowning every ship on the Sturmsee."]},{"code":101,"indent":0,"parameters":["People3",7,0,2,"Bote"]},{"code":401,"indent":0,"parameters":["And the Guild archivist adds: the Aschenkrone went to"]},{"code":401,"indent":0,"parameters":["sea in 313, and a Fomorian chief on the Knochenriff has"]},{"code":401,"indent":0,"parameters":["worn a grey crown for a hundred years."]},{"code":101,"indent":0,"parameters":["Kanta",0,0,2,"Kanta"]},{"code":401,"indent":0,"parameters":["The last one."]},{"code":121,"indent":0,"parameters":[148,148,0]},{"code":357,"indent":0,"parameters":["Story_Core","ChapterCard","Chapter Card",{"title":"Wald und Tiefe","subtitle":"3 von 4","duration":"160"}]},{"code":657,"indent":0,"parameters":["title = Wald und Tiefe"]},{"code":657,"indent":0,"parameters":["subtitle = 3 von 4"]},{"code":657,"indent":0,"parameters":["duration = 160"]},{"code":121,"indent":0,"parameters":[149,149,0]},{"code":101,"indent":0,"parameters":["",0,1,1,""]},{"code":401,"indent":0,"parameters":["\\C[6]Salzhafen\\C[0] is open (travel from any city gate)."]},{"code":123,"indent":0,"parameters":["A",0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"","direction":2,"pattern":0,"characterIndex":0},"list":[{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":
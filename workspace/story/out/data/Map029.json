:0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Kanta holds out the silver bowl."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Fubuki"]},{"code":401,"indent":0,"parameters":["My silver. Stolen by men running from the north with"]},{"code":401,"indent":0,"parameters":["ash in their hair."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Fubuki"]},{"code":401,"indent":0,"parameters":["Do you know why I froze the river? Not for a bowl."]},{"code":401,"indent":0,"parameters":["The north wind tastes of ash this spring. Something is"]},{"code":401,"indent":0,"parameters":["burning up there that should never burn."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Fubuki"]},{"code":401,"indent":0,"parameters":["I wanted this valley shut. Nothing in, nothing out."]},{"code":101,"indent":0,"parameters":["Hanma",0,0,2,"Hanma"]},{"code":401,"indent":0,"parameters":["The Wall is cracking, spirit. Everyone runs south."]},{"code":401,"indent":0,"parameters":["Shutting one valley won't stop that."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Fubuki"]},{"code":401,"indent":0,"parameters":["No. It won't."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Fubuki"]},{"code":401,"indent":0,"parameters":["Tell Eisfurt the Eis will break by morning. And you,"]},{"code":401,"indent":0,"parameters":["little vessel: go south and live, or go north and"]},{"code":401,"indent":0,"parameters":["die well. Take this, for the bowl."]},{"code":250,"indent":0,"parameters":[{"name":"Item3","volume":90,"pitch":100,"pan":0}]},{"code":128,"indent":0,"parameters":[14,0,0,1,false]},{"code":126,"indent":0,"parameters":[24,1,0,1]},{"code":315,"indent":0,"parameters":[0,1,0,0,200,true]},{"code":101,"indent":0,"parameters":["",0,1,1,""]},{"code":401,"indent":0,"parameters":["Received the Frostträne (ice damage x1/2, MAG +8)."]},{"code":357,"indent":0,"parameters":["WD_Quest","editQuestDescriptors","Edit Quest Descriptors",{"questID":"6","questName":"","icon":"0","cat":"-1","short":"","long":"","giver":"","area":"","desc":"Fubuki has her bowl back and will let the river go. Return to Eisfurt; the Vogt owes you a Goldkrone.","questTrans":"[]"}]},{"code":657,"indent":0,"parameters":["questID = 6"]},{"code":657,"indent":0,"parameters":["questName = "]},{"code":657,"indent":0,"parameters":["icon = 0"]},{"code":657,"indent":0,"parameters":["cat = -1"]},{"code":657,"indent":0,"parameters":["short = "]},{"code":657,"indent":0,"parameters":["long = "]},{"code":657,"indent":0,"parameters":["giver = "]},{"code":657,"indent":0,"parameters":["area = "]},{"code":657,"indent":0,"parameters":["desc = Fubuki has her bowl back and will let the river go. Return to Eisfurt; the Vogt owes you a Goldkrone."]},{"code":657,"indent":0,"parameters":["questTrans = []"]},{"code":121,"indent":0,"parameters":[25,25,0]},{"code":221,"indent":0,"parameters":[]},{"code":201,"indent":0,"parameters":[0,22,15,21,8,2]},{"code":222,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":2,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":25,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"","direction":2,"pattern":0,"characterIndex":0},"list":[{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":12,"y":8},

{"id":6,"name":"Okuda Noboru","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"People2","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["People2",0,0,2,"Okuda Noboru"]},{"code":401,"indent":0,"parameters":["Travelers? Welcome to Rabenau. We have little,"]},{"code":401,"indent":0,"parameters":["but you're welcome to what there is."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":9,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"People2","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["People2",0,0,2,"Okuda Noboru"]},{"code":401,"indent":0,"parameters":["Sit, sit. Tōdō tells me you stood the fence for us last"]},{"code":401,"indent":0,"parameters":["night. Rabenau thanks you. And Rabenau is poor, so"]},{"code":401,"indent":0,"parameters":["thanks is most of what it has."]},{"code":101,"indent":0,"parameters":["People2",0,0,2,"Okuda Noboru"]},{"code":401,"indent":0,"parameters":["The goblins come from the south, from the Rabenholz."]},{"code":401,"indent":0,"parameters":["There's an old watchtower in that forest, from the days"]},{"code":401,"indent":0,"parameters":["when the king's riders still patrolled this road."]},{"code":101,"indent":0,"parameters":["Peopl